        <field id="stremioTitle" type="string" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />

    <children>
        <Label id="statusLabel"
               text="Aguardando o Stremio no celular..."
               translation="[120,340]"
               width="1040"
               color="0xCCCCCCFF" />
        <Label id="debugLabel"
               text=""
               translation="[40,620]"
               width="1200"
               wrap="true"
               color="0x88CCFFFF" />
        <Video id="videoPlayer"
               translation="[0,0]"
               width="1280"
               height="720"
               visible="false" />
    </children>
</component>
