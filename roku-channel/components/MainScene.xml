<?xml version="1.0" encoding="utf-8" ?>
<component name="MainScene" extends="Scene">
    <interface>
        <field id="stremioUrl" type="string" onChange="onNewUrl" />
        <field id="stremioTitle" type="string" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />

    <children>
        <Rectangle id="bg" translation="[0,0]" width="1280" height="720" color="0x14141EFF" />

        <Group id="idleScreen">
            <Label id="welcomeLabel"
                   text="Bem-vindo, assista seus streamings caseiros aqui."
                   font="font:LargeBoldSystemFont"
                   translation="[80,320]"
                   width="1120"
                   wrap="true"
                   horizAlign="center"
                   color="0xFFFFFFFF" />

            <Label id="statusLabel"
                   text="Aguardando o Stremio no celular..."
                   translation="[80,400]"
                   width="1120"
                   horizAlign="center"
                   color="0x8A8A96FF" />
        </Group>

        <!-- DEBUG temporário — remover depois que o playback estiver confirmado. -->
        <Label id="debugUrlLabel"
               text=""
               translation="[40,30]"
               width="1200"
               wrap="true"
               color="0x88CCFFFF" />
        <Label id="debugStateLabel"
               text=""
               translation="[40,110]"
               width="1200"
               wrap="true"
               color="0xFFCC88FF" />

        <Video id="videoPlayer"
               translation="[0,0]"
               width="1280"
               height="720"
               visible="false" />

        <Label id="hintLabel"
               text=""
               translation="[40,670]"
               width="1200"
               horizAlign="center"
               color="0xAAAAAACC" />
    </children>
</component>
